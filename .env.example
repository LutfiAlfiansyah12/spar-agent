# ── Server ──────────────────────────────────────────────────────────────────
# Terminate TLS in a reverse proxy (Caddy/nginx). Spar listens on loopback.
HOST=127.0.0.1
PORT=8083
LOG_LEVEL=info

# ── Ed25519 signing key ─────────────────────────────────────────────────────
# Generated on first start at DATA_DIR/agent-ed25519.json (mode 0600); the
# public half is served at GET /publickey.
# DATA_DIR=./data

# ── Runner ──────────────────────────────────────────────────────────────────
# Per-vector HTTP timeout when probing the target agent (ms).
VECTOR_TIMEOUT_MS=10000
# Max redirect hops when probing the target (each hop is re-validated).
MAX_REDIRECTS=2
# Max eval runs processed at once (queue is serial beyond this).
MAX_CONCURRENT_RUNS=2
# TEST ONLY — allows probing loopback/private targets (local harness needs
# this). NEVER enable in production.
ALLOW_PRIVATE_TARGETS=false

# ── Rate limiting (POST /spar) ──────────────────────────────────────────────
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_S=600

# ── zkVerify anchor ─────────────────────────────────────────────────────────
# none   = no on-chain anchor (scorecards stay signed + hash-committed)
# volta  = anchor scorecard commitment via system.remark on Volta testnet
# mainnet= same, on mainnet
ANCHOR_MODE=none
# Account paying the remark fee (mnemonic/SURI). Memory of the fee is tiny;
# fund with a little testnet VFY from the faucet. NEVER commit or share.
ZKV_ANCHOR_SEED=
ZKV_RPC_WSS=wss://zkverify-volta-rpc.zkverify.io
ZKV_EXPLORER=https://zkverify-testnet.subscan.io/
ANCHOR_TIMEOUT_MS=120000
ANCHOR_POLL_MS=6000
